generator:
  code: astra
  default: clara_400_3ps
files:
  injector:
    code: astra
    charge:
      cathode: True
      space_charge_mode: 2D
      mirror_charge: True
    input:
      particle_definition: 'initial_distribution'
    output:
      zstart: 0
      end_element: CLA-S02-SIM-APER-01
  Linac:
    code: elegant
    input: {}
    output:
      start_element: CLA-S02-SIM-APER-01
      end_element: CLA-FEA-SIM-APER-01
#  FEBE:
#    code: elegant
#    charge:
#      cathode: False
#      space_charge_mode: 3D
#    input: {}
#    output:
#      start_element: CLA-FEA-SIM-APER-01
#      end_element: CLA-FED-SIM-DUMP-01-START
groups:
  bunch_compressor:
    type: chicane
    elements: [CLA-VBC-MAG-DIP-01, CLA-VBC-MAG-DIP-02, CLA-VBC-MAG-DIP-03, CLA-VBC-MAG-DIP-04]
layout: "/laura-lattices/CLARA/layouts.yaml"
section: "/laura-lattices/CLARA/sections.yaml"
element_list: "/laura-lattices/CLARA/YAML/"
